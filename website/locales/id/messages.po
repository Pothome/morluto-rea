msgstr "{ph0}03{ph1} Enam digit"

#. {ph0}: <strong>
#. {ph1}: </strong>
#: website/public/showcase/aegis/index.html:558
#, python-brace-format
msgctxt "page:showcase/aegis/index.html"
msgid ""
"{ph0}Time chooses the block.{ph1} Seconds 30 through 59 all give block 1. At"
" 60 seconds, the block becomes 2."
msgstr ""
"{ph0}Waktu memilih blok.{ph1} Detik 30 hingga 59 semuanya memberikan blok 1."
" Pada 60 detik, blok menjadi 2."

#. {ph0}: <strong>
#. {ph1}: </strong>
#: website/public/showcase/aegis/index.html:564
#, python-brace-format
msgctxt "page:showcase/aegis/index.html"
msgid ""
"{ph0}The key matters too.{ph1} The generator combines the account key with "
"the block. An account with a different key can show a different code at the "
"same time."
msgstr ""
"{ph0}Kuncinya juga penting.{ph1} Generator menggabungkan kunci akun dengan "
"blok. Akun dengan kunci yang berbeda dapat menampilkan kode yang berbeda "
"secara bersamaan."

#. {ph0}: <strong>
#. {ph1}: </strong>
#: website/public/showcase/aegis/index.html:571
#, python-brace-format
msgctxt "page:showcase/aegis/index.html"
msgid ""
"{ph0}Keep six digits.{ph1} The remainder after division by 1,000,000 is "
"padded with zeroes when needed, so a code can begin with 0."
msgstr ""
"{ph0}Simpan enam digit.{ph1} Sisanya setelah pembagian dengan 1.000.000 "
"diisi dengan angka nol bila diperlukan, sehingga kode dapat dimulai dengan "
"0."


msgctxt "page:first-investigation/index.html"
msgid ""
"{ph0}How Notion copies text and HTML{ph1}{ph2}Follow a clipboard feature in "
"a packaged Electron app.{ph3}"
msgstr ""
"{ph0}Bagaimana Notion menyalin teks dan HTML{ph1}{ph2}Ikuti fitur papan klip"
" di aplikasi Electron yang dikemas.{ph3}"


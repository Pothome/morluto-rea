msgid "{ph0}{ph1}{ph2}{ph3}{ph4}{ph5}{ph6}{ph7}Your coding agent"
msgstr "{ph0}{ph1}{ph2}{ph3}{ph4}{ph5}{ph6}{ph7}Agen pengkodean Anda"

#: website/public/first-investigation/index.html:230
#: website/public/first-investigation/index.html:252
#: website/public/first-investigation/index.html:280
#: website/public/first-investigation/index.html:402
#: website/public/first-investigation/index.html:444
msgctxt "page:first-investigation/index.html"
msgid "Copy"
msgstr "Salin"

#: website/public/first-investigation/index.html:249

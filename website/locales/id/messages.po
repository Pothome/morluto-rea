#. {ph1}: </span>
#: website/public/showcase/aegis/index.html:491
#, python-brace-format
msgctxt "page:showcase/aegis/index.html"
msgid "{ph0}02{ph1} Key + block"
msgstr "{ph0}02{ph1} Kunci + blok"


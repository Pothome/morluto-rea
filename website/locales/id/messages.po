msgid "{ph0}01{ph1} Decode branches"
msgstr "{ph0}01{ph1} Dekode cabang"

#. {ph0}: <span>
#. {ph1}: </span>
#: website/public/index.html:338
#, python-brace-format
msgctxt "page:index.html"
msgid "{ph0}02{ph1} Trace calls"
msgstr "{ph0}02{ph1} Melacak panggilan"

#. {ph0}: <span>
#. {ph1}: </span>
#: website/public/index.html:346
#, python-brace-format
msgctxt "page:index.html"
msgid "{ph0}03{ph1} Recover the rule"
msgstr "{ph0}03{ph1} Pulihkan aturan"

#. {ph0}: <span>
#. {ph1}: </span>
#. {ph2}: <span class="assembly-disclosure" aria-hidden="true">
#. {ph3}: </span>
#: website/public/index.html:361
#, python-brace-format
msgctxt "page:index.html"
